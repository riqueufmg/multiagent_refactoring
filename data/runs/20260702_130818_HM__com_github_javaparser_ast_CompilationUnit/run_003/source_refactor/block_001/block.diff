+/* Helper class extracted from CompilationUnit to encapsulate printing responsibilities */
+package com.github.javaparser.ast;
+
+import com.github.javaparser.printer.Printer;
+import com.github.javaparser.printer.ConfigurablePrinter;
+import com.github.javaparser.printer.configuration.PrinterConfiguration;
+
+public class CompilationUnitPrinter {
+    private final CompilationUnit compilationUnit;
+
+    public CompilationUnitPrinter(CompilationUnit compilationUnit) {
+        this.compilationUnit = compilationUnit;
+    }
+
+    public CompilationUnit printer(Printer printer) {
+        // store the printer on the compilation unit using the existing data key
+        compilationUnit.setData(Node.PRINTER_KEY, printer);
+        return compilationUnit;
+    }
+
+    protected Printer getPrinter() {
+        if (!compilationUnit.containsData(Node.PRINTER_KEY)) {
+            // create a default printer via compilation unit's available method
+            Printer printer = compilationUnit.createDefaultPrinter();
+            printer(printer);
+        }
+        return compilationUnit.getData(Node.PRINTER_KEY);
+    }
+
+    protected Printer getPrinter(PrinterConfiguration config) {
+        Printer printer = getPrinter();
+        if (printer instanceof ConfigurablePrinter) {
+            ((ConfigurablePrinter) printer).setConfiguration(config);
+        }
+        printer(printer);
+        return printer;
+    }
+}
