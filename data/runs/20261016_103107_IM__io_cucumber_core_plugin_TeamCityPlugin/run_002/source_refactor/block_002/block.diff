@@ -0,0 +1,74 @@
+package io.cucumber.core.plugin;
+
+import io.cucumber.plugin.event.HookTestStep;
+import io.cucumber.plugin.event.PickleStepTestStep;
+import io.cucumber.plugin.event.TestStep;
+import io.cucumber.plugin.event.TestStepStarted;
+
+import java.util.Locale;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+final class TeamCityStepFormatter {
+    private static final Pattern ANNOTATION_GLUE_CODE_LOCATION_PATTERN = Pattern.compile("^(.*)\\.(.*)\\([^:]*\\)");
+    private static final Pattern LAMBDA_GLUE_CODE_LOCATION_PATTERN = Pattern.compile("^(.*)\\.(.*)\\(.*:.*\\)");
+
+    String extractLocation(TestStepStarted event) {
+        TestStep step = event.getTestStep();
+        if (step instanceof PickleStepTestStep) {
+            PickleStepTestStep pickle = (PickleStepTestStep) step;
+            return pickle.getUri() + ":" + pickle.getStep().getLine();
+        }
+        if (step instanceof HookTestStep)
+            return formatHookStepLocation((HookTestStep) step, javaTestLocationUri(), TestStep::getCodeLocation);
+        return step.getCodeLocation();
+    }
+
+    private static BiFunction<String, String, String> javaTestLocationUri() {
+        return (declaringClass, method) -> String.format("java:test://%s/%s", declaringClass, method);
+    }
+
+    String formatHookStepLocation(
+            HookTestStep hook, BiFunction<String, String, String> format, Function<HookTestStep, String> fallback
+    ) {
+        Matcher matcher = ANNOTATION_GLUE_CODE_LOCATION_PATTERN.matcher(hook.getCodeLocation());
+        if (matcher.matches())
+            return format.apply(matcher.group(1), matcher.group(2));
+        matcher = LAMBDA_GLUE_CODE_LOCATION_PATTERN.matcher(hook.getCodeLocation());
+        if (matcher.matches()) {
+            String declaringClass = matcher.group(1);
+            int separator = declaringClass.lastIndexOf(".");
+            String simpleName = separator == -1 ? declaringClass : declaringClass.substring(separator + 1);
+            return format.apply(declaringClass, simpleName);
+        }
+        return fallback.apply(hook);
+    }
+
+    String getHookName(HookTestStep hook) {
+        switch (hook.getHookType()) {
+            case BEFORE:
+                return "Before";
+            case AFTER:
+                return "After";
+            case BEFORE_STEP:
+                return "BeforeStep";
+            case AFTER_STEP:
+                return "AfterStep";
+            default:
+                return hook.getHookType().name().toLowerCase(Locale.US);
+        }
+    }
+
+    String extractName(TestStep step) {
+        if (step instanceof PickleStepTestStep)
+            return ((PickleStepTestStep) step).getStep().getText();
+        if (step instanceof HookTestStep) {
+            HookTestStep hook = (HookTestStep) step;
+            return formatHookStepLocation(hook,
+                (declaringClass, method) -> String.format("%s(%s)", getHookName(hook), method), this::getHookName);
+        }
+        return "Unknown step";
+    }
+}
