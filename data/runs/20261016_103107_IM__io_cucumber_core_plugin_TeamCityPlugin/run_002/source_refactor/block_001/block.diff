+package io.cucumber.core.plugin;
+
+import io.cucumber.plugin.event.Event;
+
+import java.io.PrintStream;
+import java.time.ZoneOffset;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+
+class TeamCityMessageFormatter {
+    private static final DateTimeFormatter DATE_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'hh:mm:ss.SSSZ");
+    private static final String TEAMCITY_PREFIX = "##teamcity";
+    static final String TEMPLATE_ENTER_THE_MATRIX = TEAMCITY_PREFIX + "[enteredTheMatrix timestamp = '%s']";
+    static final String TEMPLATE_TEST_RUN_STARTED = TEAMCITY_PREFIX
+            + "[testSuiteStarted timestamp = '%s' name = 'Cucumber']";
+    static final String TEMPLATE_TEST_RUN_FINISHED = TEAMCITY_PREFIX
+            + "[testSuiteFinished timestamp = '%s' name = 'Cucumber']";
+    static final String TEMPLATE_TEST_SUITE_STARTED = TEAMCITY_PREFIX
+            + "[testSuiteStarted timestamp = '%s' locationHint = '%s' name = '%s']";
+    static final String TEMPLATE_TEST_SUITE_FINISHED = TEAMCITY_PREFIX
+            + "[testSuiteFinished timestamp = '%s' name = '%s']";
+    static final String TEMPLATE_TEST_STARTED = TEAMCITY_PREFIX
+            + "[testStarted timestamp = '%s' locationHint = '%s' captureStandardOutput = 'true' name = '%s']";
+    static final String TEMPLATE_TEST_FINISHED = TEAMCITY_PREFIX
+            + "[testFinished timestamp = '%s' duration = '%s' name = '%s']";
+    static final String TEMPLATE_TEST_FAILED = TEAMCITY_PREFIX
+            + "[testFailed timestamp = '%s' duration = '%s' message = '%s' details = '%s' name = '%s']";
+    static final String TEMPLATE_TEST_COMPARISON_FAILED = TEAMCITY_PREFIX
+            + "[testFailed timestamp = '%s' duration = '%s' message = '%s' details = '%s' expected = '%s' actual = '%s' name = '%s']";
+    static final String TEMPLATE_TEST_IGNORED = TEAMCITY_PREFIX
+            + "[testIgnored timestamp = '%s' duration = '%s' message = '%s' name = '%s']";
+    static final String TEMPLATE_BEFORE_ALL_AFTER_ALL_STARTED = TEAMCITY_PREFIX
+            + "[testStarted timestamp = '%s' name = '%s']";
+    static final String TEMPLATE_BEFORE_ALL_AFTER_ALL_FAILED = TEAMCITY_PREFIX
+            + "[testFailed timestamp = '%s' message = '%s' details = '%s' name = '%s']";
+    static final String TEMPLATE_BEFORE_ALL_AFTER_ALL_FINISHED = TEAMCITY_PREFIX
+            + "[testFinished timestamp = '%s' name = '%s']";
+    static final String TEMPLATE_PROGRESS_COUNTING_STARTED = TEAMCITY_PREFIX
+            + "[customProgressStatus testsCategory = 'Scenarios' count = '0' timestamp = '%s']";
+    static final String TEMPLATE_PROGRESS_COUNTING_FINISHED = TEAMCITY_PREFIX
+            + "[customProgressStatus testsCategory = '' count = '0' timestamp = '%s']";
+    static final String TEMPLATE_PROGRESS_TEST_STARTED = TEAMCITY_PREFIX
+            + "[customProgressStatus type = 'testStarted' timestamp = '%s']";
+    static final String TEMPLATE_PROGRESS_TEST_FINISHED = TEAMCITY_PREFIX
+            + "[customProgressStatus type = 'testFinished' timestamp = '%s']";
+    static final String TEMPLATE_ATTACH_WRITE_EVENT = TEAMCITY_PREFIX + "[message text='%s' status='NORMAL']";
+
+    private final PrintStream out;
+
+    TeamCityMessageFormatter(PrintStream out) {
+        this.out = out;
+    }
+
+    void print(String command, Object... args) {
+        out.println(formatCommand(command, args));
+    }
+
+    String formatCommand(String command, Object... parameters) {
+        String[] escapedParameters = new String[parameters.length];
+        for (int i = 0; i < escapedParameters.length; i++) {
+            escapedParameters[i] = escape(parameters[i].toString());
+        }
+        return String.format(command, (Object[]) escapedParameters);
+    }
+
+    String escape(String source) {
+        if (source == null) {
+            return "";
+        }
+        return source.replace("|", "||").replace("'", "|'").replace("\n", "|n").replace("\r", "|r")
+                .replace("[", "|[").replace("]", "|]");
+    }
+
+    String extractTimeStamp(Event event) {
+        ZonedDateTime date = event.getInstant().atZone(ZoneOffset.UTC);
+        return DATE_FORMAT.format(date);
+    }
+}
