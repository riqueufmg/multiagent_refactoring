1599        op_state.borrow_mut().put(TestState {
                               |apply|apply
                                      |ARG      |
                                      |STRUCT()

1600          mode,
              |ARG

1601          dispatch_count: dispatch_count.clone(),
              |ARG                                 |
                                                  |apply

1602        });
1603    
1604        runtime.register_op("test", dispatch);
                               |apply
                                |ARG |  |ARG   |

1605    
1606        runtime
1607          .execute(
