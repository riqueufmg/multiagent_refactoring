1613              }
1614            }
1615            "#,
1616          )
1617          .unwrap();
                     |apply

1618        assert_eq!(dispatch_count.load(Ordering::Relaxed), 0);
            |MACRO()| |macro(){                                 |}macro()

1619        (runtime, dispatch_count)
            |tuple(
             |T_ELEM  |T_ELEM      ||)tuple

1620      }
          |}func

