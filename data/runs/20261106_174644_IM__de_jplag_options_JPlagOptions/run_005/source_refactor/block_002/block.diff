@@ -0,0 +1,44 @@
+package de.jplag.options;
+
+import de.jplag.Language;
+
+public class JPlagLanguageOptionAccess {
+
+    private final JPlagLanguageOptions languageOptions;
+
+    public JPlagLanguageOptionAccess(JPlagLanguageOptions languageOptions) {
+        this.languageOptions = languageOptions;
+    }
+
+    public String[] getFileSuffixes() {
+        return languageOptions.getFileSuffixes();
+    }
+
+    public String getLanguageIdentifier() {
+        return languageOptions.getLanguageIdentifier();
+    }
+
+    public Language getLanguage() {
+        return languageOptions.getLanguage();
+    }
+
+    public Verbosity getVerbosity() {
+        return languageOptions.getVerbosity();
+    }
+
+    public void setFileSuffixes(String[] fileSuffixes) {
+        languageOptions.setFileSuffixes(fileSuffixes);
+    }
+
+    public void setLanguage(Language language) {
+        languageOptions.setLanguage(language);
+    }
+
+    public void setLanguageDefaults(Language language) {
+        languageOptions.setLanguageDefaults(language);
+    }
+
+    public void setVerbosity(Verbosity verbosity) {
+        languageOptions.setVerbosity(verbosity);
+    }
+}
