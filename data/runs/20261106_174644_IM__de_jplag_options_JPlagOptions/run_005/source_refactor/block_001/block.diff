+package de.jplag.options;
+
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+
+public class JPlagSubmissionOptionAccess {
+
+    private final JPlagSubmissionOptions submissionOptions;
+
+    public JPlagSubmissionOptionAccess(JPlagSubmissionOptions submissionOptions) {
+        this.submissionOptions = submissionOptions;
+    }
+
+    public Optional<String> getBaseCodeSubmissionName() {
+        return submissionOptions.getBaseCodeSubmissionName();
+    }
+
+    public Set<String> getExcludedFiles() {
+        return submissionOptions.getExcludedFiles();
+    }
+
+    public String getExclusionFileName() {
+        return submissionOptions.getExclusionFileName();
+    }
+
+    public List<String> getSubmissionDirectories() {
+        return submissionOptions.getSubmissionDirectories();
+    }
+
+    public List<String> getOldSubmissionDirectories() {
+        return submissionOptions.getOldSubmissionDirectories();
+    }
+
+    public String getSubdirectoryName() {
+        return submissionOptions.getSubdirectoryName();
+    }
+
+    public boolean hasBaseCode() {
+        return submissionOptions.hasBaseCode();
+    }
+
+    public void setBaseCodeSubmissionName(String baseCodeSubmissionName) {
+        submissionOptions.setBaseCodeSubmissionName(baseCodeSubmissionName);
+    }
+
+    public void setExcludedFiles(Set<String> excludedFiles) {
+        submissionOptions.setExcludedFiles(excludedFiles);
+    }
+
+    public void setExclusionFileName(String exclusionFileName) {
+        submissionOptions.setExclusionFileName(exclusionFileName);
+    }
+
+    public void setSubmissionDirectories(List<String> submissionDirectories) {
+        submissionOptions.setSubmissionDirectories(submissionDirectories);
+    }
+
+    public void setOldSubmissionDirectories(List<String> oldSubmissionDirectories) {
+        submissionOptions.setOldSubmissionDirectories(oldSubmissionDirectories);
+    }
+
+    public void setSubdirectoryName(String subdirectoryName) {
+        submissionOptions.setSubdirectoryName(subdirectoryName);
+    }
+}
