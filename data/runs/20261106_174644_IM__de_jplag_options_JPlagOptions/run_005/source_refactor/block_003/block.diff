+package de.jplag.options;
+
+import de.jplag.strategy.ComparisonMode;
+
+public class JPlagComparisonOptionAccess {
+
+    private final JPlagComparisonOptions comparisonOptions;
+
+    public JPlagComparisonOptionAccess(JPlagComparisonOptions comparisonOptions) {
+        this.comparisonOptions = comparisonOptions;
+    }
+
+    public ComparisonMode getComparisonMode() {
+        return comparisonOptions.getComparisonMode();
+    }
+
+    public int getMaximumNumberOfComparisons() {
+        return comparisonOptions.getMaximumNumberOfComparisons();
+    }
+
+    public Integer getMinimumTokenMatch() {
+        return comparisonOptions.getMinimumTokenMatch();
+    }
+
+    public SimilarityMetric getSimilarityMetric() {
+        return comparisonOptions.getSimilarityMetric();
+    }
+
+    public float getSimilarityThreshold() {
+        return comparisonOptions.getSimilarityThreshold();
+    }
+
+    public boolean isDebugParser() {
+        return comparisonOptions.isDebugParser();
+    }
+
+    public void setComparisonMode(ComparisonMode comparisonMode) {
+        comparisonOptions.setComparisonMode(comparisonMode);
+    }
+
+    public void setDebugParser(boolean debugParser) {
+        comparisonOptions.setDebugParser(debugParser);
+    }
+
+    public void setMaximumNumberOfComparisons(int maximumNumberOfComparisons) {
+        comparisonOptions.setMaximumNumberOfComparisons(maximumNumberOfComparisons);
+    }
+
+    public void setMinimumTokenMatch(Integer minimumTokenMatch) {
+        comparisonOptions.setMinimumTokenMatch(minimumTokenMatch);
+    }
+
+    public void setSimilarityMetric(SimilarityMetric similarityMetric) {
+        comparisonOptions.setSimilarityMetric(similarityMetric);
+    }
+
+    public void setSimilarityThreshold(float similarityThreshold) {
+        comparisonOptions.setSimilarityThreshold(similarityThreshold);
+    }
+}
