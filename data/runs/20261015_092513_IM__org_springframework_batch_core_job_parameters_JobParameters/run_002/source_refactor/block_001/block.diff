+		}
+		return (Double) jobParameter.getValue();
+	}
+
+	public @Nullable Double getDouble(String key, @Nullable Double defaultValue) {
+		if (parameters.containsKey(key)) {
+			return getDouble(key);
+		}
+		return defaultValue;
+	}
+
+	public @Nullable Date getDate(String key) {
