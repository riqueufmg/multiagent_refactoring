+                } else if (StringUtil.inSorted(name, HtmlTreeBuilderStateConstants.InBodyStartDrop)) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                } else {
+                    tb.reconstructFormattingElements();
+                    tb.insertElementFor(startTag);
+                }
+        }
+        return true;
+    }
