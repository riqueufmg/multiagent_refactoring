diff --git a/src/main/java/org/jsoup/parser/HtmlTreeBuilderStateUtil.java b/src/main/java/org/jsoup/parser/HtmlTreeBuilderStateUtil.java
index 75cab0af..1c52f0c0 100644
--- a/src/main/java/org/jsoup/parser/HtmlTreeBuilderStateUtil.java
+++ b/src/main/java/org/jsoup/parser/HtmlTreeBuilderStateUtil.java
@@ -13,6 +13,8 @@ import org.jspecify.annotations.Nullable;
 import java.util.ArrayList;
 
 import static org.jsoup.parser.HtmlTreeBuilder.isSpecial;
+import static org.jsoup.internal.StringUtil.inSorted;
+import static org.jsoup.parser.HtmlTreeBuilderStateConstants.*;
 
 /**
  * Utility helpers extracted from HtmlTreeBuilderState to reduce enum method footprint.
@@ -561,4 +563,179 @@ public class HtmlTreeBuilderStateUtil {
         return true;
     }
 
+    public static boolean inBodyEndTag(Token t, HtmlTreeBuilder tb) {
+        final Token.EndTag endTag = t.asEndTag();
+        final String name = endTag.normalName();
+
+        switch (name) {
+            case "template":
+                tb.process(t, HtmlTreeBuilderState.InHead);
+                break;
+            case "sarcasm": // *sigh*
+            case "span":
+                // same as final fall through, but saves short circuit
+                return HtmlTreeBuilderStateUtil.anyOtherEndTag(t, tb);
+            case "li":
+                if (!tb.inListItemScope(name)) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                } else {
+                    tb.generateImpliedEndTags(name);
+                    if (!tb.currentElementIs(name))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.popStackToClose(name);
+                }
+                break;
+            case "body":
+                if (!tb.inScope("body")) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                } else {
+                    if (tb.onStackNot(InBodyEndOtherErrors))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.trackNodePosition(tb.getFromStack("body"), false); // track source position of close; body is left on stack, in case of trailers
+                    tb.transition(HtmlTreeBuilderState.AfterBody);
+                }
+                break;
+            case "html":
+                if (!tb.onStack("body")) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false; // ignore
+                } else {
+                    if (tb.onStackNot(InBodyEndOtherErrors))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.transition(HtmlTreeBuilderState.AfterBody);
+                    return tb.process(t); // re-process
+                }
+
+            case "form":
+                if (!tb.onStack("template")) {
+                    Element currentForm = tb.getFormElement();
+                    tb.setFormElement(null);
+                    if (currentForm == null || !tb.inScope(name)) {
+                        tb.error(HtmlTreeBuilderState.InBody);
+                        return false;
+                    }
+                    tb.generateImpliedEndTags();
+                    if (!tb.currentElementIs(name))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    // remove currentForm from stack. will shift anything under up.
+                    tb.removeFromStack(currentForm);
+                } else { // template on stack
+                    if (!tb.inScope(name)) {
+                        tb.error(HtmlTreeBuilderState.InBody);
+                        return false;
+                    }
+                    tb.generateImpliedEndTags();
+                    if (!tb.currentElementIs(name)) tb.error(HtmlTreeBuilderState.InBody);
+                    tb.popStackToClose(name);
+                }
+                break;
+            case "p":
+                if (!tb.inButtonScope(name)) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    tb.processStartTag(name); // if no p to close, creates an empty <p></p>
+                    return tb.process(endTag);
+                } else {
+                    tb.generateImpliedEndTags(name);
+                    if (!tb.currentElementIs(name))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.popStackToClose(name);
+                }
+                break;
+            case "dd":
+            case "dt":
+                if (!tb.inScope(name)) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                } else {
+                    tb.generateImpliedEndTags(name);
+                    if (!tb.currentElementIs(name))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.popStackToClose(name);
+                }
+                break;
+            case "h1":
+            case "h2":
+            case "h3":
+            case "h4":
+            case "h5":
+            case "h6":
+                if (!tb.hasHeadingInScope()) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                } else {
+                    tb.generateImpliedEndTags(name);
+                    if (!tb.currentElementIs(name))
+                        tb.error(HtmlTreeBuilderState.InBody);
+                    tb.popStackToClose(HtmlTreeBuilderStateConstants.Headings);
+                }
+                break;
+            case "br":
+                tb.error(HtmlTreeBuilderState.InBody);
+                tb.processStartTag("br");
+                return false;
+            default:
+                // todo - move rest to switch if desired
+                if (inSorted(name, HtmlTreeBuilderStateConstants.InBodyEndAdoptionFormatters)) {
+                    return HtmlTreeBuilderStateUtil.inBodyEndTagAdoption(t, tb);
+                } else if (inSorted(name, HtmlTreeBuilderStateConstants.InBodyEndClosers)) {
+                    if (!tb.inScope(name)) {
+                        // nothing to close
+                        tb.error(HtmlTreeBuilderState.InBody);
+                        return false;
+                    } else {
+                        tb.generateImpliedEndTags();
+                        if (!tb.currentElementIs(name))
+                            tb.error(HtmlTreeBuilderState.InBody);
+                        tb.popStackToClose(name);
+                    }
+                } else if (inSorted(name, HtmlTreeBuilderStateConstants.InBodyStartApplets)) {
+                    if (!tb.inScope("name")) {
+                        if (!tb.inScope(name)) {
+                            tb.error(HtmlTreeBuilderState.InBody);
+                            return false;
+                        }
+                        tb.generateImpliedEndTags();
+                        if (!tb.currentElementIs(name))
+                            tb.error(HtmlTreeBuilderState.InBody);
+                        tb.popStackToClose(name);
+                        tb.clearFormattingElementsToLastMarker();
+                    }
+                } else {
+                    return HtmlTreeBuilderStateUtil.anyOtherEndTag(t, tb);
+                }
+        }
+        return true;
+    }
+
+    public static boolean anyOtherEndTag(Token t, HtmlTreeBuilder tb) {
+        final String name = t.asEndTag().normalName; // case insensitive search - goal is to preserve output case, not for the parse to be case sensitive
+        final ArrayList<Element> stack = tb.getStack();
+
+        // deviate from spec slightly to speed when super deeply nested
+        Element elFromStack = tb.getFromStack(name);
+        if (elFromStack == null) {
+            tb.error(HtmlTreeBuilderState.InBody);
+            return false;
+        }
+
+        for (int pos = stack.size() - 1; pos >= 0; pos--) {
+            Element node = stack.get(pos);
+            if (node.nameIs(name)) {
+                tb.generateImpliedEndTags(name);
+                if (!tb.currentElementIs(name))
+                    tb.error(HtmlTreeBuilderState.InBody);
+                tb.popStackToClose(name);
+                break;
+            } else {
+                if (isSpecial(node)) {
+                    tb.error(HtmlTreeBuilderState.InBody);
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
 }
