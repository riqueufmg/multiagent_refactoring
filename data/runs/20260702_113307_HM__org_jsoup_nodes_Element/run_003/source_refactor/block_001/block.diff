+package org.jsoup.nodes;
+
+import org.jsoup.select.Elements;
+
+import java.util.List;
+
+/**
+ * Package-private helper to host a small set of Element instance helper methods that wrap
+ * XPath/regex query helpers and the endSourceRange utility. This centralises the external
+ * dependencies so Element no longer directly references ElementQueryHelper or Range.
+ */
+final class ElementQuerySupport {
+
+    private ElementQuerySupport() {
+        // no instantiation
+    }
+
+    public static Elements selectXpath(Element el, String xpath) {
+        return ElementQueryHelper.selectXpath(el, xpath);
+    }
+
+    public static <T extends Node> List<T> selectXpath(Element el, String xpath, Class<T> nodeType) {
+        return ElementQueryHelper.selectXpath(el, xpath, nodeType);
+    }
+
+    public static Elements getElementsByAttributeValueMatching(Element el, String key, String regex) {
+        return ElementQueryHelper.getElementsByAttributeValueMatching(el, key, regex);
+    }
+
+    public static Elements getElementsMatchingText(Element el, String regex) {
+        return ElementQueryHelper.getElementsMatchingText(el, regex);
+    }
+
+    public static Range endSourceRange(Element el) {
+        return Range.ofEnd(el);
+    }
+}
