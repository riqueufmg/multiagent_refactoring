diff --git a/src/main/java/org/jsoup/nodes/ElementQueryHelper.java b/src/main/java/org/jsoup/nodes/ElementQueryHelper.java
new file mode 100644
index 00000000..d5fe695d
--- /dev/null
+++ b/src/main/java/org/jsoup/nodes/ElementQueryHelper.java
@@ -0,0 +1,55 @@
+package org.jsoup.nodes;
+
+import org.jsoup.helper.Regex;
+import org.jsoup.select.Collector;
+import org.jsoup.select.Evaluator;
+import org.jsoup.select.Elements;
+
+import java.util.List;
+import java.util.regex.PatternSyntaxException;
+
+/**
+ * Helper class extracted from Element to hold query-related helpers that used regex and xpath selection logic.
+ * Methods are public static and accept an Element as the context parameter.
+ */
+public final class ElementQueryHelper {
+    private ElementQueryHelper() {}
+
+    public static Elements getElementsByAttributeValueMatching(Element el, String key, String regex) {
+        Regex pattern;
+        try {
+            pattern = Regex.compile(regex);
+        } catch (PatternSyntaxException e) {
+            throw new IllegalArgumentException("Pattern syntax error: " + regex, e);
+        }
+        return Collector.collect(new Evaluator.AttributeWithValueMatching(key, pattern), el);
+    }
+
+    public static Elements getElementsMatchingText(Element el, String regex) {
+        Regex pattern;
+        try {
+            pattern = Regex.compile(regex);
+        } catch (PatternSyntaxException e) {
+            throw new IllegalArgumentException("Pattern syntax error: " + regex, e);
+        }
+        return Collector.collect(new Evaluator.Matches(pattern), el);
+    }
+
+    public static Elements getElementsMatchingOwnText(Element el, String regex) {
+        Regex pattern;
+        try {
+            pattern = Regex.compile(regex);
+        } catch (PatternSyntaxException e) {
+            throw new IllegalArgumentException("Pattern syntax error: " + regex, e);
+        }
+        return Collector.collect(new Evaluator.MatchesOwn(pattern), el);
+    }
+
+    public static Elements selectXpath(Element el, String xpath) {
+        return new Elements(NodeUtils.selectXpath(xpath, el, Element.class));
+    }
+
+    public static <T extends Node> List<T> selectXpath(Element el, String xpath, Class<T> nodeType) {
+        return NodeUtils.selectXpath(xpath, el, nodeType);
+    }
+}
