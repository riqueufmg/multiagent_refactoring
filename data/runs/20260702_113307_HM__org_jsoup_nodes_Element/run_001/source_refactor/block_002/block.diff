@@ -0,0 +1,68 @@
+package org.jsoup.nodes;
+
+import org.jsoup.internal.Normalizer;
+import org.jsoup.internal.QuietAppendable;
+import org.jsoup.internal.StringUtil;
+import org.jsoup.nodes.Document;
+import org.jsoup.nodes.Document.OutputSettings;
+import org.jsoup.nodes.Printer;
+import org.jsoup.nodes.Node;
+import org.jsoup.parser.Parser;
+import org.jsoup.parser.Tag;
+
+/**
+ * Helper class extracted from Element to handle HTML/XML serialization duties.
+ * The methods are public static and accept an Element context where needed.
+ */
+public final class ElementHtmlSerializer {
+
+    private ElementHtmlSerializer() {}
+
+    public static String html(Element el) {
+        StringBuilder sb = StringUtil.borrowBuilder();
+        html(el, sb);
+        String html = StringUtil.releaseBuilder(sb);
+        return NodeUtils.outputSettings(el).prettyPrint() ? html.trim() : html;
+    }
+
+    public static <T extends Appendable> T html(Element el, T accum) {
+        Node child = el.firstChild();
+        if (child != null) {
+            Printer printer = Printer.printerFor(child, QuietAppendable.wrap(accum));
+            while (child != null) {
+                printer.traverse(child);
+                child = child.nextSibling();
+            }
+        }
+        return accum;
+    }
+
+    public static void outerHtmlHead(Element el, QuietAppendable accum, Document.OutputSettings out) {
+        String tagName = safeTagName(el, out.syntax());
+        accum.append('<').append(tagName);
+        if (el.attributes != null) el.attributes.html(accum, out);
+
+        if (el.childNodes.isEmpty()) {
+            boolean xmlMode = out.syntax() == Document.OutputSettings.Syntax.xml || !el.tag.namespace().equals(Parser.NamespaceHtml);
+            if (xmlMode && (el.tag.is(Tag.SeenSelfClose) || (el.tag.isKnownTag() && (el.tag.isEmpty() || el.tag.isSelfClosing())))) {
+                accum.append(" />");
+            } else if (!xmlMode && el.tag.isEmpty()) { // html void element
+                accum.append('>');
+            } else {
+                accum.append("></").append(tagName).append('>');
+            }
+        } else {
+            accum.append('>');
+        }
+    }
+
+    public static void outerHtmlTail(Element el, QuietAppendable accum, Document.OutputSettings out) {
+        if (!el.childNodes.isEmpty())
+            accum.append("</").append(safeTagName(el, out.syntax())).append('>');
+        // if empty, we have already closed in htmlHead
+    }
+
+    public static String safeTagName(Element el, Document.OutputSettings.Syntax syntax) {
+        return syntax == Document.OutputSettings.Syntax.xml ? Normalizer.xmlSafeTagName(el.tagName()) : el.tagName();
+    }
+}
