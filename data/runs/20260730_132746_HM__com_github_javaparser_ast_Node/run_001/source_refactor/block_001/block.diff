+/*
+ * Helper class extracted from Node to centralize equality and hashCode logic.
+ */
+package com.github.javaparser.ast;
+
+import com.github.javaparser.ast.visitor.EqualsVisitor;
+import com.github.javaparser.ast.visitor.HashCodeVisitor;
+
+public final class NodeEquality {
+
+    private NodeEquality() {
+        // utility class
+    }
+
+    public static int hashCode(Node node) {
+        return HashCodeVisitor.hashCode(node);
+    }
+
+    public static boolean equals(Node node, Object obj) {
+        if (!(obj instanceof Node)) {
+            return false;
+        }
+        return EqualsVisitor.equals(node, (Node) obj);
+    }
+}
