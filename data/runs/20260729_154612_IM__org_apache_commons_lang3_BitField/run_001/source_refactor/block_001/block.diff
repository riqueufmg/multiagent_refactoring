+package org.apache.commons.lang3;
+
+public final class BitFieldSupport {
+
+    private BitFieldSupport() {
+        // utility class
+    }
+
+    /* Shift count helper (used by BitField constructor) */
+    public static int getShiftCount(final long mask) {
+        return Long.numberOfTrailingZeros(mask);
+    }
+
+    /* Long-specific operations */
+    public static long clearLong(final long mask, final long holder) {
+        return holder & ~mask;
+    }
+
+    public static long getRawValueLong(final long mask, final long holder) {
+        return holder & mask;
+    }
+
+    public static long getValueLong(final long mask, final int shiftCount, final long holder) {
+        return (holder & mask) >>> shiftCount;
+    }
+
+    public static boolean isAllSetLong(final long mask, final long holder) {
+        return (holder & mask) == mask;
+    }
+
+    public static boolean isSetLong(final long mask, final long holder) {
+        return (holder & mask) != 0L;
+    }
+
+    public static long setLong(final long mask, final long holder) {
+        return holder | mask;
+    }
+
+    public static long setBooleanLong(final long mask, final int shiftCount, final long holder, final boolean flag) {
+        return flag ? setLong(mask, holder) : clearLong(mask, holder);
+    }
+
+    public static long setValueLong(final long mask, final int shiftCount, final long holder, final long value) {
+        long cleared = holder & ~mask;
+        long v = (value << shiftCount) & mask;
+        return cleared | v;
+    }
+
+    /* Byte wrappers */
+    public static byte clearByte(final long mask, final byte holder) {
+        int h = holder & 0xFF;
+        int m = (int) mask & 0xFF;
+        return (byte) (h & ~m);
+    }
+
+    public static byte setByte(final long mask, final byte holder) {
+        int h = holder & 0xFF;
+        int m = (int) mask & 0xFF;
+        return (byte) (h | m);
+    }
+
+    public static byte setByteBoolean(final long mask, final byte holder, final boolean flag) {
+        return flag ? setByte(mask, holder) : clearByte(mask, holder);
+    }
+
+    /* Short wrappers */
+    public static short clearShort(final long mask, final short holder) {
+        int h = holder & 0xFFFF;
+        int m = (int) mask & 0xFFFF;
+        return (short) (h & ~m);
+    }
+
+    public static short getShortRawValue(final long mask, final short holder) {
+        int h = holder & 0xFFFF;
+        int m = (int) mask & 0xFFFF;
+        return (short) (h & m);
+    }
+
+    public static short getShortValue(final long mask, final int shiftCount, final short holder) {
+        int h = holder & 0xFFFF;
+        int m = (int) mask & 0xFFFF;
+        return (short) ((h & m) >>> shiftCount);
+    }
+
+    public static short setShort(final long mask, final short holder) {
+        int h = holder & 0xFFFF;
+        int m = (int) mask & 0xFFFF;
+        return (short) (h | m);
+    }
+
+    public static short setShortBoolean(final long mask, final short holder, final boolean flag) {
+        return flag ? setShort(mask, holder) : clearShort(mask, holder);
+    }
+
+    public static short setShortValue(final long mask, final int shiftCount, final short holder, final short value) {
+        int h = holder & 0xFFFF;
+        int m = (int) mask & 0xFFFF;
+        int cleared = h & ~m;
+        int v = ((value & 0xFFFF) << shiftCount) & m;
+        return (short) (cleared | v);
+    }
+}
