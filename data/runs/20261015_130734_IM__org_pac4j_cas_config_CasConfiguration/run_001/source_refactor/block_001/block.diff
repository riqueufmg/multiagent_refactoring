+++ b/pac4j-cas/src/main/java/org/pac4j/cas/config/CasTicketValidatorFactory.java
@@ -0,0 +1,147 @@
+package org.pac4j.cas.config;
+
+import org.apereo.cas.client.ssl.HttpURLConnectionFactory;
+import org.apereo.cas.client.validation.Cas10TicketValidator;
+import org.apereo.cas.client.validation.Cas20ProxyTicketValidator;
+import org.apereo.cas.client.validation.Cas20ServiceTicketValidator;
+import org.apereo.cas.client.validation.Cas30ProxyTicketValidator;
+import org.apereo.cas.client.validation.Cas30ServiceTicketValidator;
+import org.apereo.cas.client.validation.Saml11TicketValidator;
+import org.apereo.cas.client.validation.TicketValidator;
+import org.pac4j.cas.store.ProxyGrantingTicketStore;
+import org.pac4j.core.context.WebContext;
+
+import javax.net.ssl.HttpsURLConnection;
+import java.net.HttpURLConnection;
+import java.net.URLConnection;
+import java.util.Optional;
+
+public class CasTicketValidatorFactory {
+
+    private final CasConfiguration configuration;
+
+    public CasTicketValidatorFactory(final CasConfiguration configuration) {
+        this.configuration = configuration;
+    }
+
+    public TicketValidator retrieveTicketValidator(final WebContext context) {
+        final TicketValidator defaultTicketValidator = configuration.getDefaultTicketValidator();
+        if (defaultTicketValidator != null) {
+            return defaultTicketValidator;
+        }
+        switch (configuration.getProtocol()) {
+            case CAS10:
+                return buildCas10TicketValidator(context);
+            case CAS20:
+                return buildCas20TicketValidator(context);
+            case CAS20_PROXY:
+                return buildCas20ProxyTicketValidator(context);
+            case CAS30:
+                return buildCas30TicketValidator(context);
+            case CAS30_PROXY:
+                return buildCas30ProxyTicketValidator(context);
+            case SAML:
+                return buildSAMLTicketValidator(context);
+            default:
+                throw new org.pac4j.core.exception.TechnicalException("Unable to initialize the TicketValidator for protocol: " + configuration.getProtocol());
+        }
+    }
+
+    public TicketValidator buildSAMLTicketValidator(final WebContext context) {
+        final Saml11TicketValidator validator = new Saml11TicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setTolerance(configuration.getTimeTolerance());
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    public void addPrivateKey(final Cas20ServiceTicketValidator validator) {
+        if (configuration.getPrivateKey() != null) {
+            validator.setPrivateKey(configuration.getPrivateKey());
+        }
+    }
+
+    public TicketValidator buildCas30ProxyTicketValidator(final WebContext context) {
+        final Cas30ProxyTicketValidator validator = new Cas30ProxyTicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        validator.setAcceptAnyProxy(configuration.isAcceptAnyProxy());
+        validator.setAllowedProxyChains(configuration.getAllowedProxyChains());
+        configureProxy(validator, context);
+        addPrivateKey(validator);
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    public TicketValidator buildCas30TicketValidator(final WebContext context) {
+        final Cas30ServiceTicketValidator validator = new Cas30ServiceTicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        configureProxy(validator, context);
+        addPrivateKey(validator);
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    public TicketValidator buildCas20ProxyTicketValidator(final WebContext context) {
+        final Cas20ProxyTicketValidator validator = new Cas20ProxyTicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        validator.setAcceptAnyProxy(configuration.isAcceptAnyProxy());
+        validator.setAllowedProxyChains(configuration.getAllowedProxyChains());
+        configureProxy(validator, context);
+        addPrivateKey(validator);
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    public TicketValidator buildCas20TicketValidator(final WebContext context) {
+        final Cas20ServiceTicketValidator validator = new Cas20ServiceTicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        configureProxy(validator, context);
+        addPrivateKey(validator);
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    public TicketValidator buildCas10TicketValidator(final WebContext context) {
+        final Cas10TicketValidator validator = new Cas10TicketValidator(configuration.computeFinalPrefixUrl(context));
+        validator.setEncoding(configuration.getEncoding());
+        validator.setRenew(configuration.isRenew());
+        getHttpURLConnectionFactory().ifPresent(validator::setURLConnectionFactory);
+        return validator;
+    }
+
+    private void configureProxy(final Cas20ServiceTicketValidator validator, final WebContext context) {
+        if (configuration.getProxyReceptor() != null) {
+            validator.setProxyCallbackUrl(configuration.getProxyReceptor().computeFinalCallbackUrl(context));
+            validator.setProxyGrantingTicketStorage(new ProxyGrantingTicketStore(configuration.getProxyReceptor().getStore()));
+        }
+    }
+
+    private Optional<HttpURLConnectionFactory> getHttpURLConnectionFactory() {
+        if (configuration.getSslSocketFactory() == null && configuration.getHostnameVerifier() == null) {
+            return Optional.empty();
+        }
+        final HttpURLConnectionFactory factory = new HttpURLConnectionFactory() {
+            private static final long serialVersionUID = 7296708420276819683L;
+
+            @Override
+            public HttpURLConnection buildHttpURLConnection(final URLConnection conn) {
+                if (conn instanceof HttpsURLConnection) {
+                    final HttpsURLConnection httpsConnection = (HttpsURLConnection) conn;
+                    if (configuration.getSslSocketFactory() != null) {
+                        httpsConnection.setSSLSocketFactory(configuration.getSslSocketFactory());
+                    }
+                    if (configuration.getHostnameVerifier() != null) {
+                        httpsConnection.setHostnameVerifier(configuration.getHostnameVerifier());
+                    }
+                }
+                return (HttpURLConnection) conn;
+            }
+        };
+        return Optional.of(factory);
+    }
+}
