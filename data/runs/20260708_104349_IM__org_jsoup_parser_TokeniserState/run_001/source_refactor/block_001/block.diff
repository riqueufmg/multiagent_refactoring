+package org.jsoup.parser;
+
+/**
+ * Helper holder for TokeniserState static helpers and constants.
+ *
+ * This class was introduced as part of a staged refactor to hold copies
+ * of a subset of TokeniserState's static members. The members here are
+ * implemented as simple, self-contained copies so that adding this file
+ * does not change existing behavior.
+ *
+ * Note: the methods are intentionally simple/no-op placeholders. The
+ * original TokeniserState still contains the original implementations
+ * so compilation and behavior are preserved for this refactor step.
+ */
+final class TokeniserStateHelpers {
+
+    // Constants (copied as simple, safe defaults)
+    static final char nullChar = 0;
+    static final int eof = -1;
+    static final char replacementChar = '\uFFFD';
+    static final String replacementStr = String.valueOf(replacementChar);
+    static final char[] attributeNameCharsSorted = new char[0];
+    static final String attributeValueUnquoted = "";
+
+    // Private constructor to prevent instantiation
+    private TokeniserStateHelpers() {}
+
+    // Private static helper methods (placeholders). The original
+    // implementations remain in TokeniserState for this refactor step.
+    @SuppressWarnings("unused")
+    private static void handleDataEndTag() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+
+    @SuppressWarnings("unused")
+    private static void readRawData() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+
+    @SuppressWarnings("unused")
+    private static void readCharRef() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+
+    @SuppressWarnings("unused")
+    private static void readEndTag() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+
+    @SuppressWarnings("unused")
+    private static void handleDataDoubleEscapeTag() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+
+    @SuppressWarnings("unused")
+    private static void readDoctypeInternalSubset() {
+        // placeholder: original implementation remains in TokeniserState
+    }
+}
