+package org.apache.commons.io.function;
+
+import java.util.Iterator;
+import java.util.List;
+
+/**
+ * Minimal API abstraction for IOExceptionList used by classes in the org.apache.commons.io.function package.
+ * This declares only the methods required to interact with an IOExceptionList instance.
+ */
+public interface IOExceptionListApi {
+
+    /**
+     * Returns this throwable's cause or {@code null}.
+     * @return the cause throwable or {@code null}
+     */
+    Throwable getCause();
+
+    /**
+     * Gets the cause exception at the given index.
+     * @param <T> type of exception to return.
+     * @param index index in the cause list.
+     * @return The cause at the given index.
+     */
+    <T extends Throwable> T getCause(int index);
+
+    /**
+     * Gets the cause exception at the given index cast to the requested type.
+     * @param <T> type of exception to return.
+     * @param index index in the cause list.
+     * @param clazz type of exception to return.
+     * @return The cause at the given index.
+     */
+    <T extends Throwable> T getCause(int index, Class<T> clazz);
+
+    /**
+     * Gets the cause list.
+     * @param <T> type of exception to return.
+     * @return The list of causes.
+     */
+    <T extends Throwable> List<T> getCauseList();
+
+    /**
+     * Gets the cause list cast to the requested type.
+     * @param <T> type of exception to return.
+     * @param clazz the target type.
+     * @return The list of causes.
+     */
+    <T extends Throwable> List<T> getCauseList(Class<T> clazz);
+
+    /**
+     * Iterator over the causes.
+     * @return iterator
+     */
+    Iterator<Throwable> iterator();
+
+    /**
+     * Returns the detail message string of this throwable.
+     * @return the message
+     */
+    String getMessage();
+
+}
