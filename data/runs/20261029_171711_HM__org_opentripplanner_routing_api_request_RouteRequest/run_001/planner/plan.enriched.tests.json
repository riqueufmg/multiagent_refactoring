          ],
          "outputs": [
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequestLocationSupport.java"
          ],
          "details": "Add the same-package RouteRequestLocationSupport reference where RouteRequest delegates the extracted location behavior. Remove RouteRequest imports for LocationStringParser, SphericalDistanceLibrary, Coordinate, and Envelope only after confirming no direct references remain. Retain imports required by the unchanged public signatures and fields, including GenericLocation and Vertex. Add the extracted class imports for LocationStringParser, SphericalDistanceLibrary, Coordinate, Envelope, GenericLocation, Vertex, ArrayList, and List as needed by the moved implementation.",
          "risk": "low"
        },
