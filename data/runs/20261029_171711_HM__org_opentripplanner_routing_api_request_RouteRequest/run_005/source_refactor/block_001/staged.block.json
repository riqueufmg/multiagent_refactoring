  "ops": [
    {
      "op": "EXTRACT_CLASS",
      "inputs": [
        "org.opentripplanner.routing.api.request.RouteRequest",
        "org.opentripplanner.routing.api.request.RouteRequestSpatialSupport"
      ],
      "outputs": [
        "org.opentripplanner.routing.api.request.RouteRequestSpatialSupport"
      ],
      "details": "Move MAX_CLOSENESS_METERS, fromEnvelope, toEnvelope, getEnvelope(Coordinate, int), and the spatial calculation currently implemented by isCloseToStartOrEnd(Vertex) into RouteRequestSpatialSupport. Keep RouteRequest.isCloseToStartOrEnd(Vertex) as a compatibility method delegating to the extracted support class, passing its existing from, to, and Vertex values. After the move, RouteRequest no longer directly references Coordinate, Envelope, or SphericalDistanceLibrary; it introduces only the new RouteRequestSpatialSupport dependency. GenericLocation and Vertex remain direct dependencies because they are used by the retained public method and existing fields or APIs. The expected net Fan-Out reduction is two: three distinct dependencies are removed and one new helper dependency is introduced.",
      "risk": "medium"
    },
    {
      "op": "ADD_OR_UPDATE_IMPORTS",
      "inputs": [
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequestSpatialSupport.java"
      ],
      "outputs": [
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequestSpatialSupport.java"
      ],
      "details": "Remove Coordinate, Envelope, and SphericalDistanceLibrary imports from RouteRequest after the spatial implementation is moved, and add the imports required by RouteRequestSpatialSupport for Coordinate, Envelope, GenericLocation, SphericalDistanceLibrary, and Vertex. Do not remove the Vertex or GenericLocation imports from RouteRequest because the public method and existing fields continue to use them.",
      "risk": "low"
    },
