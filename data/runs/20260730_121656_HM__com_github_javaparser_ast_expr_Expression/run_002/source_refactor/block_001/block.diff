+package com.github.javaparser.ast.expr;
+
+import static com.github.javaparser.utils.CodeGenerationUtils.f;
+
+import java.util.Optional;
+import java.util.function.Consumer;
+
+/**
+ * Helper class that centralizes annotation-related type checks, casts,
+ * optional conversions and conditional consumers for Expression instances.
+ */
+public final class ExpressionAnnotationsHelper {
+
+    private ExpressionAnnotationsHelper() {
+        // utility
+    }
+
+    public static boolean isAnnotationExpr(Expression expr) {
+        return expr instanceof AnnotationExpr;
+    }
+
+    public static AnnotationExpr asAnnotationExpr(Expression expr) {
+        if (expr instanceof AnnotationExpr) {
+            return (AnnotationExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not AnnotationExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<AnnotationExpr> toAnnotationExpr(Expression expr) {
+        return expr instanceof AnnotationExpr ? Optional.of((AnnotationExpr) expr) : Optional.empty();
+    }
+
+    public static void ifAnnotationExpr(Expression expr, Consumer<AnnotationExpr> action) {
+        if (expr instanceof AnnotationExpr) {
+            action.accept((AnnotationExpr) expr);
+        }
+    }
+
+    public static boolean isNormalAnnotationExpr(Expression expr) {
+        return expr instanceof NormalAnnotationExpr;
+    }
+
+    public static NormalAnnotationExpr asNormalAnnotationExpr(Expression expr) {
+        if (expr instanceof NormalAnnotationExpr) {
+            return (NormalAnnotationExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not NormalAnnotationExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<NormalAnnotationExpr> toNormalAnnotationExpr(Expression expr) {
+        return expr instanceof NormalAnnotationExpr ? Optional.of((NormalAnnotationExpr) expr) : Optional.empty();
+    }
+
+    public static void ifNormalAnnotationExpr(Expression expr, Consumer<NormalAnnotationExpr> action) {
+        if (expr instanceof NormalAnnotationExpr) {
+            action.accept((NormalAnnotationExpr) expr);
+        }
+    }
+
+    public static boolean isMarkerAnnotationExpr(Expression expr) {
+        return expr instanceof MarkerAnnotationExpr;
+    }
+
+    public static MarkerAnnotationExpr asMarkerAnnotationExpr(Expression expr) {
+        if (expr instanceof MarkerAnnotationExpr) {
+            return (MarkerAnnotationExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not MarkerAnnotationExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<MarkerAnnotationExpr> toMarkerAnnotationExpr(Expression expr) {
+        return expr instanceof MarkerAnnotationExpr ? Optional.of((MarkerAnnotationExpr) expr) : Optional.empty();
+    }
+
+    public static void ifMarkerAnnotationExpr(Expression expr, Consumer<MarkerAnnotationExpr> action) {
+        if (expr instanceof MarkerAnnotationExpr) {
+            action.accept((MarkerAnnotationExpr) expr);
+        }
+    }
+
+    public static boolean isSingleMemberAnnotationExpr(Expression expr) {
+        return expr instanceof SingleMemberAnnotationExpr;
+    }
+
+    public static SingleMemberAnnotationExpr asSingleMemberAnnotationExpr(Expression expr) {
+        if (expr instanceof SingleMemberAnnotationExpr) {
+            return (SingleMemberAnnotationExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not SingleMemberAnnotationExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<SingleMemberAnnotationExpr> toSingleMemberAnnotationExpr(Expression expr) {
+        return expr instanceof SingleMemberAnnotationExpr ? Optional.of((SingleMemberAnnotationExpr) expr) : Optional.empty();
+    }
+
+    public static void ifSingleMemberAnnotationExpr(Expression expr, Consumer<SingleMemberAnnotationExpr> action) {
+        if (expr instanceof SingleMemberAnnotationExpr) {
+            action.accept((SingleMemberAnnotationExpr) expr);
+        }
+    }
+}
