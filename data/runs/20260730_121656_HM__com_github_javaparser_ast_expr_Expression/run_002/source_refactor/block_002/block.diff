+/*
+ * Helper for literal-related checks and casts extracted from Expression to
+ * reduce direct dependencies on literal classes inside Expression.
+ */
+package com.github.javaparser.ast.expr;
+
+import static com.github.javaparser.utils.CodeGenerationUtils.f;
+
+import java.util.Optional;
+import java.util.function.Consumer;
+
+public final class ExpressionLiteralHelper {
+
+    private ExpressionLiteralHelper() {
+        // utility
+    }
+
+    // String literal helpers
+    public static boolean isStringLiteralExpr(Expression expr) {
+        return expr instanceof StringLiteralExpr;
+    }
+
+    public static StringLiteralExpr asStringLiteralExpr(Expression expr) {
+        if (expr instanceof StringLiteralExpr) {
+            return (StringLiteralExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not StringLiteralExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<StringLiteralExpr> toStringLiteralExpr(Expression expr) {
+        return expr instanceof StringLiteralExpr ? Optional.of((StringLiteralExpr) expr) : Optional.empty();
+    }
+
+    public static void ifStringLiteralExpr(Expression expr, Consumer<StringLiteralExpr> action) {
+        if (expr instanceof StringLiteralExpr) {
+            action.accept((StringLiteralExpr) expr);
+        }
+    }
+
+    // Integer literal helpers
+    public static boolean isIntegerLiteralExpr(Expression expr) {
+        return expr instanceof IntegerLiteralExpr;
+    }
+
+    public static IntegerLiteralExpr asIntegerLiteralExpr(Expression expr) {
+        if (expr instanceof IntegerLiteralExpr) {
+            return (IntegerLiteralExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not IntegerLiteralExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<IntegerLiteralExpr> toIntegerLiteralExpr(Expression expr) {
+        return expr instanceof IntegerLiteralExpr ? Optional.of((IntegerLiteralExpr) expr) : Optional.empty();
+    }
+
+    public static void ifIntegerLiteralExpr(Expression expr, Consumer<IntegerLiteralExpr> action) {
+        if (expr instanceof IntegerLiteralExpr) {
+            action.accept((IntegerLiteralExpr) expr);
+        }
+    }
+
+    // Double literal helpers
+    public static boolean isDoubleLiteralExpr(Expression expr) {
+        return expr instanceof DoubleLiteralExpr;
+    }
+
+    public static DoubleLiteralExpr asDoubleLiteralExpr(Expression expr) {
+        if (expr instanceof DoubleLiteralExpr) {
+            return (DoubleLiteralExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not DoubleLiteralExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<DoubleLiteralExpr> toDoubleLiteralExpr(Expression expr) {
+        return expr instanceof DoubleLiteralExpr ? Optional.of((DoubleLiteralExpr) expr) : Optional.empty();
+    }
+
+    public static void ifDoubleLiteralExpr(Expression expr, Consumer<DoubleLiteralExpr> action) {
+        if (expr instanceof DoubleLiteralExpr) {
+            action.accept((DoubleLiteralExpr) expr);
+        }
+    }
+
+    // Long literal helpers
+    public static boolean isLongLiteralExpr(Expression expr) {
+        return expr instanceof LongLiteralExpr;
+    }
+
+    public static LongLiteralExpr asLongLiteralExpr(Expression expr) {
+        if (expr instanceof LongLiteralExpr) {
+            return (LongLiteralExpr) expr;
+        }
+        throw new IllegalStateException(f("%s is not LongLiteralExpr, it is %s", expr, expr.getClass().getSimpleName()));
+    }
+
+    public static Optional<LongLiteralExpr> toLongLiteralExpr(Expression expr) {
+        return expr instanceof LongLiteralExpr ? Optional.of((LongLiteralExpr) expr) : Optional.empty();
+    }
+
+    public static void ifLongLiteralExpr(Expression expr, Consumer<LongLiteralExpr> action) {
+        if (expr instanceof LongLiteralExpr) {
+            action.accept((LongLiteralExpr) expr);
+        }
+    }
+}
