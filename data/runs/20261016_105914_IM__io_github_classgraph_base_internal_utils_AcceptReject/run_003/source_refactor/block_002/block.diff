+ *
+ * The MIT License (MIT)
+ */
+package io.github.classgraph.base.internal.utils;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+
+/** Prefix-based accept or reject criteria. */
+public class AcceptRejectPrefix extends AcceptReject {
+    public AcceptRejectPrefix(final char separatorChar) {
+        super(separatorChar);
+    }
+
+    @Override
+    public void addToAccept(final String str) {
+        if (AcceptRejectUtils.containsWildcard(str)) {
+            if (acceptGlobs == null || acceptPatterns == null) {
+                acceptGlobs = new HashSet<>();
+                acceptPatterns = new ArrayList<>();
+            }
+            acceptGlobs.add(str);
+            acceptPatterns.add(AcceptRejectUtils.globToPattern(str, separatorChar, true));
+        } else {
+            if (acceptPrefixesSet == null) {
+                acceptPrefixesSet = new HashSet<>();
+            }
+            acceptPrefixesSet.add(str);
+        }
+    }
+
+    @Override
+    public void addToReject(final String str) {
+        if (AcceptRejectUtils.containsWildcard(str)) {
+            if (rejectGlobs == null || rejectPatterns == null) {
+                rejectGlobs = new HashSet<>();
+                rejectPatterns = new ArrayList<>();
+            }
+            rejectGlobs.add(str);
+            rejectPatterns.add(AcceptRejectUtils.globToPattern(str, separatorChar, true));
+        } else {
+            if (rejectPrefixes == null) {
+                rejectPrefixes = new ArrayList<>();
+            }
+            rejectPrefixes.add(str);
+        }
+    }
+
+    @Override
+    public boolean isAcceptedAndNotRejected(final String str) {
+        var accepted = acceptPrefixes == null && acceptPatterns == null;
+        if (!accepted && acceptPrefixes != null) {
+            for (final String prefix : acceptPrefixes) {
+                if (str.startsWith(prefix)) {
+                    accepted = true;
+                    break;
+                }
+            }
+        }
+        if (!accepted) {
+            accepted = AcceptRejectUtils.matchesPatternList(str, acceptPatterns);
+        }
+        if (!accepted) {
+            return false;
+        }
+        if (rejectPrefixes != null) {
+            for (final String prefix : rejectPrefixes) {
+                if (str.startsWith(prefix)) {
+                    return false;
+                }
+            }
+        }
+        return !AcceptRejectUtils.matchesPatternList(str, rejectPatterns);
+    }
+
+    @Override
+    public boolean isAccepted(final String str) {
+        var accepted = acceptPrefixes == null && acceptPatterns == null;
+        if (!accepted && acceptPrefixes != null) {
+            for (final String prefix : acceptPrefixes) {
+                if (str.startsWith(prefix)) {
+                    accepted = true;
+                    break;
+                }
+            }
+        }
+        return accepted || AcceptRejectUtils.matchesPatternList(str, acceptPatterns);
+    }
+
+    @Override
+    public boolean acceptHasPrefix(final String str) {
+        throw new IllegalArgumentException("Can only find prefixes of whole strings");
+    }
+
+    @Override
+    public boolean isRejected(final String str) {
+        if (rejectPrefixes != null) {
+            for (final String prefix : rejectPrefixes) {
+                if (str.startsWith(prefix)) {
+                    return true;
+                }
+            }
+        }
+        return AcceptRejectUtils.matchesPatternList(str, rejectPatterns);
+    }
+}
