+package org.opentripplanner.routing.api.request;
+
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.util.ArrayList;
+import java.util.List;
+import org.opentripplanner.api.common.LocationStringParser;
+import org.opentripplanner.model.GenericLocation;
+import org.opentripplanner.util.time.DateUtils;
+
+/**
+ * Support for converting legacy request input values into routing request values.
+ */
+public final class RouteRequestInputSupport {
+
+  private RouteRequestInputSupport() {}
+
+  public static GenericLocation parseLocation(String value) {
+    return LocationStringParser.fromOldStyleString(value);
+  }
+
+  public static Instant parseDateTime(String date, String time, ZoneId timeZone) {
+    ZonedDateTime dateObject = DateUtils.toZonedDateTime(date, time, timeZone);
+    return dateObject == null ? Instant.now() : dateObject.toInstant();
+  }
+
+  public static List<GenericLocation> parseIntermediatePlaces(List<String> places) {
+    List<GenericLocation> result = new ArrayList<>(places.size());
+    for (String place : places) {
+      result.add(parseLocation(place));
+    }
+    return result;
+  }
+
+  public static List<GenericLocation> addIntermediatePlace(
+    List<GenericLocation> intermediatePlaces,
+    GenericLocation location
+  ) {
+    if (intermediatePlaces == null) {
+      intermediatePlaces = new ArrayList<>();
+    }
+    intermediatePlaces.add(location);
+    return intermediatePlaces;
+  }
+}
