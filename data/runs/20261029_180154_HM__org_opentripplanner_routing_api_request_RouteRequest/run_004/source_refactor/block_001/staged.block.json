  "ops": [
    {
      "op": "EXTRACT_CLASS",
      "inputs": [
        "org.opentripplanner.routing.api.request.RouteRequest",
        "org.opentripplanner.routing.api.request.RouteRequestSpatial"
      ],
      "outputs": [
        "org.opentripplanner.routing.api.request.RouteRequestSpatial"
      ],
      "details": "Extract the spatial proximity behavior implemented by RouteRequest.isCloseToStartOrEnd(Vertex), the private getEnvelope(Coordinate, int) helper, and the associated fromEnvelope and toEnvelope state into RouteRequestSpatial. Keep RouteRequest.isCloseToStartOrEnd(Vertex) as a compatibility-preserving wrapper that delegates the calculation to RouteRequestSpatial, and preserve the existing null checks, MAX_CLOSENESS_METERS behavior, envelope intersection checks, and coordinate conversion behavior. After extraction, RouteRequest must no longer directly reference Coordinate, Envelope, or SphericalDistanceLibrary; these classes remain referenced only by RouteRequestSpatial. RouteRequest will gain one new outgoing dependency, RouteRequestSpatial, while eliminating three distinct outgoing dependencies, for an expected net Fan-Out reduction of two. Vertex, GenericLocation, and the public RouteRequest API remain in RouteRequest because they are required by the existing method and fields.",
      "risk": "medium"
    },
    {
      "op": "ADD_OR_UPDATE_IMPORTS",
      "inputs": [
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequestSpatial.java"
      ],
      "outputs": [
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
        "src/main/java/org/opentripplanner/routing/api/request/RouteRequestSpatial.java"
      ],
      "details": "Remove Coordinate, Envelope, and SphericalDistanceLibrary imports from RouteRequest after the spatial logic and envelope state have been extracted. Add the corresponding imports to RouteRequestSpatial. No import is required for RouteRequestSpatial in RouteRequest because both classes are placed in org.opentripplanner.routing.api.request.",
      "risk": "low"
    },
