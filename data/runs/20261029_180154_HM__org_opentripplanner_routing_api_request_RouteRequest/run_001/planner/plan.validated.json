        {
          "op": "EXTRACT_CLASS",
          "inputs": [
            "org.opentripplanner.routing.api.request.RouteRequest",
            "org.opentripplanner.routing.api.request.RouteRequestLocationProximity"
          ],
          "outputs": [
            "org.opentripplanner.routing.api.request.RouteRequestLocationProximity"
          ],
          "details": "Move the private fromEnvelope and toEnvelope fields, the getEnvelope(Coordinate, int) helper, and the geometric calculation currently implemented by isCloseToStartOrEnd(Vertex) into the new same-package RouteRequestLocationProximity class. The extracted class should accept the existing GenericLocation values and Vertex value needed by the calculation and retain the MAX_CLOSENESS_METERS value used by RouteRequest. Keep RouteRequest.isCloseToStartOrEnd(Vertex) as a public compatibility method that delegates to the extracted responsibility. After this change RouteRequest should no longer directly reference Coordinate, Envelope, or SphericalDistanceLibrary; those dependencies remain in RouteRequestLocationProximity. RouteRequest gains only the new RouteRequestLocationProximity dependency, so the expected net Fan-Out reduction is two distinct dependencies: three eliminated minus one introduced. Vertex, GenericLocation, and the public RouteRequest API remain required dependencies and are not counted as removed.",
          "risk": "medium"
        },
        {
          "op": "ADD_OR_UPDATE_IMPORTS",
          "inputs": [
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequestLocationProximity.java"
          ],
          "outputs": [
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequest.java",
            "src/main/java/org/opentripplanner/routing/api/request/RouteRequestLocationProximity.java"
          ],
          "details": "Remove Coordinate, Envelope, and SphericalDistanceLibrary imports from RouteRequest and add the imports required by RouteRequestLocationProximity for Coordinate, Envelope, GenericLocation, SphericalDistanceLibrary, and Vertex. Do not remove the Vertex or GenericLocation imports from RouteRequest because the public proximity method and existing location accessors still reference them.",
          "risk": "low"
        },
