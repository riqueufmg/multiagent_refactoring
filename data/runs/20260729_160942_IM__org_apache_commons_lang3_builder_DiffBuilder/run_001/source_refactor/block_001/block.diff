+package org.apache.commons.lang3.builder;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Supplier;
+
+import org.apache.commons.lang3.ArrayUtils;
+import org.apache.commons.lang3.ObjectUtils;
+
+/**
+ * Helper class extracted from DiffBuilder to host the many append overload implementations.
+ */
+public final class DiffBuilderAppenders {
+
+    private DiffBuilderAppenders() {
+        // utility
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final boolean lhs, final boolean rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Boolean.valueOf(lhs), Boolean.valueOf(rhs), Boolean.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final boolean[] lhs, final boolean[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Boolean[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final byte lhs, final byte rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Byte.valueOf(lhs), Byte.valueOf(rhs), Byte.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final byte[] lhs, final byte[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Byte[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final char lhs, final char rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Character.valueOf(lhs), Character.valueOf(rhs), Character.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final char[] lhs, final char[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Character[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final DiffResult<?> diffResult) {
+        Objects.requireNonNull(diffResult, "diffResult");
+        if (equals) {
+            return;
+        }
+        for (final Diff<?> diff : diffResult.getDiffs()) {
+            append(diffs, equals, fieldName + "." + diff.getFieldName(), diff.getLeft(), diff.getRight());
+        }
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final double lhs, final double rhs) {
+        if (equals || Double.doubleToLongBits(lhs) == Double.doubleToLongBits(rhs)) {
+            return;
+        }
+        add(diffs, fieldName, Double.valueOf(lhs), Double.valueOf(rhs), Double.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final double[] lhs, final double[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Double[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final float lhs, final float rhs) {
+        if (equals || Float.floatToIntBits(lhs) == Float.floatToIntBits(rhs)) {
+            return;
+        }
+        add(diffs, fieldName, Float.valueOf(lhs), Float.valueOf(rhs), Float.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final float[] lhs, final float[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Float[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final int lhs, final int rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Integer.valueOf(lhs), Integer.valueOf(rhs), Integer.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final int[] lhs, final int[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Integer[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final long lhs, final long rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Long.valueOf(lhs), Long.valueOf(rhs), Long.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final long[] lhs, final long[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Long[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final Object lhs, final Object rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        final Object test = lhs != null ? lhs : rhs;
+        if (ObjectUtils.isArray(test)) {
+            if (test instanceof boolean[]) {
+                append(diffs, equals, fieldName, (boolean[]) lhs, (boolean[]) rhs);
+                return;
+            }
+            if (test instanceof byte[]) {
+                append(diffs, equals, fieldName, (byte[]) lhs, (byte[]) rhs);
+                return;
+            }
+            if (test instanceof char[]) {
+                append(diffs, equals, fieldName, (char[]) lhs, (char[]) rhs);
+                return;
+            }
+            if (test instanceof double[]) {
+                append(diffs, equals, fieldName, (double[]) lhs, (double[]) rhs);
+                return;
+            }
+            if (test instanceof float[]) {
+                append(diffs, equals, fieldName, (float[]) lhs, (float[]) rhs);
+                return;
+            }
+            if (test instanceof int[]) {
+                append(diffs, equals, fieldName, (int[]) lhs, (int[]) rhs);
+                return;
+            }
+            if (test instanceof long[]) {
+                append(diffs, equals, fieldName, (long[]) lhs, (long[]) rhs);
+                return;
+            }
+            if (test instanceof short[]) {
+                append(diffs, equals, fieldName, (short[]) lhs, (short[]) rhs);
+                return;
+            }
+            // Object[]
+            append(diffs, equals, fieldName, (Object[]) lhs, (Object[]) rhs);
+            return;
+        }
+        if (Objects.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, lhs, rhs, Object.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final Object[] lhs, final Object[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, lhs, rhs, Object[].class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final short lhs, final short rhs) {
+        if (equals || lhs == rhs) {
+            return;
+        }
+        add(diffs, fieldName, Short.valueOf(lhs), Short.valueOf(rhs), Short.class);
+    }
+
+    public static void append(final List<Diff<?>> diffs, final boolean equals, final String fieldName, final short[] lhs, final short[] rhs) {
+        if (equals || Arrays.equals(lhs, rhs)) {
+            return;
+        }
+        add(diffs, fieldName, ArrayUtils.toObject(lhs), ArrayUtils.toObject(rhs), Short[].class);
+    }
+
+    private static void add(final List<Diff<?>> diffs, final String fieldName, final Object left, final Object right, final Class<?> type) {
+        diffs.add(new Diff<Object>(fieldName, (Class) type) {
+            private static final long serialVersionUID = 1L;
+
+            @Override
+            public Object getLeft() {
+                return left;
+            }
+
+            @Override
+            public Object getRight() {
+                return right;
+            }
+        });
+    }
+
+}
