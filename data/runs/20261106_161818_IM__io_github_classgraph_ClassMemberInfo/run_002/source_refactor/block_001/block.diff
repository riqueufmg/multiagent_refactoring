@@ -0,0 +1,113 @@
+/*
+ * This file is part of ClassGraph.
+ *
+ * The MIT License (MIT)
+ */
+package io.github.classgraph;
+
+import static io.github.classgraph.PotentiallyUnmodifiableList.unmodifiable;
+
+import java.lang.annotation.Annotation;
+import java.lang.annotation.Repeatable;
+
+import nonapi.io.github.classgraph.utils.Assert;
+import org.jspecify.annotations.Nullable;
+
+/** Holds annotation metadata for a class member. */
+final class ClassMemberAnnotationInfo {
+    /** The annotation on the class member, if any. */
+    @Nullable
+    private final AnnotationInfoList annotationInfo;
+
+    /** The annotation infos, once they are loaded. */
+    private @Nullable AnnotationInfoList annotationInfoRef;
+
+    /** The class member owning this annotation metadata. */
+    private final ClassMemberInfo classMemberInfo;
+
+    ClassMemberAnnotationInfo(final ClassMemberInfo classMemberInfo,
+            final @Nullable AnnotationInfoList annotationInfo) {
+        this.classMemberInfo = classMemberInfo;
+        this.annotationInfo = annotationInfo == null || annotationInfo.isEmpty() ? null : annotationInfo;
+    }
+
+    AnnotationInfoList getAllAnnotationInfo() {
+        synchronized (this) {
+            if (annotationInfoRef != null) {
+                return annotationInfoRef;
+            }
+
+            if (!classMemberInfo.scanResult().scanSpec.enableAnnotationInfo) {
+                throw new IllegalStateException("Please call ClassGraph#enableAnnotationInfo() before #scan()");
+            }
+
+            annotationInfoRef = annotationInfo == null ? AnnotationInfoList.EMPTY_LIST
+                    : unmodifiable(
+                            AnnotationInfoList.getIndirectAnnotations(annotationInfo, /* annotatedClass = */ null));
+            return annotationInfoRef;
+        }
+    }
+
+    AnnotationInfoList getDirectAnnotationInfo() {
+        return getAllAnnotationInfo().directOnly();
+    }
+
+    @Nullable
+    AnnotationInfo getAllAnnotationInfo(final Class<? extends Annotation> annotation) {
+        Assert.notNull(annotation, "annotation");
+        Assert.isAnnotation(annotation);
+        return getAllAnnotationInfo(annotation.getName());
+    }
+
+    @Nullable
+    AnnotationInfo getAllAnnotationInfo(final String annotationName) {
+        Assert.notNull(annotationName, "annotationName");
+        return getAllAnnotationInfo().get(annotationName);
+    }
+
+    @Nullable
+    AnnotationInfo getDirectAnnotationInfo(final Class<? extends Annotation> annotation) {
+        Assert.notNull(annotation, "annotation");
+        Assert.isAnnotation(annotation);
+        return getDirectAnnotationInfo(annotation.getName());
+    }
+
+    @Nullable
+    AnnotationInfo getDirectAnnotationInfo(final String annotationName) {
+        Assert.notNull(annotationName, "annotationName");
+        return getDirectAnnotationInfo().get(annotationName);
+    }
+
+    AnnotationInfoList getAllAnnotationInfoRepeatable(final Class<? extends Annotation> annotation) {
+        Assert.notNull(annotation, "annotation");
+        Assert.isAnnotation(annotation);
+        return getAllAnnotationInfoRepeatable(annotation.getName());
+    }
+
+    AnnotationInfoList getAllAnnotationInfoRepeatable(final String annotationName) {
+        Assert.notNull(annotationName, "annotationName");
+        return getAllAnnotationInfo().getRepeatable(annotationName);
+    }
+
+    AnnotationInfoList getDirectAnnotationInfoRepeatable(final Class<? extends Annotation> annotation) {
+        Assert.notNull(annotation, "annotation");
+        Assert.isAnnotation(annotation);
+        return getDirectAnnotationInfoRepeatable(annotation.getName());
+    }
+
+    AnnotationInfoList getDirectAnnotationInfoRepeatable(final String annotationName) {
+        Assert.notNull(annotationName, "annotationName");
+        return getDirectAnnotationInfo().getRepeatable(annotationName);
+    }
+
+    boolean hasAnnotation(final Class<? extends Annotation> annotation) {
+        Assert.notNull(annotation, "annotation");
+        Assert.isAnnotation(annotation);
+        return hasAnnotation(annotation.getName());
+    }
+
+    boolean hasAnnotation(final String annotationName) {
+        Assert.notNull(annotationName, "annotationName");
+        return getAllAnnotationInfo().containsName(annotationName);
+    }
+}
