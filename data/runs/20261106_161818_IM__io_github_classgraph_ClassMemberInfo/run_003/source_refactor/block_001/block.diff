+/*
+ * This file is part of ClassGraph.
+ *
+ * Author: Luke Hutchison
+ *
+ * Hosted at: https://github.com/classgraph/classgraph
+ *
+ * The MIT License (MIT)
+ */
+package io.github.classgraph;
+
+import java.lang.annotation.Annotation;
+
+import org.jspecify.annotations.Nullable;
+
+/** Annotation metadata access and query facade for a class member. */
+final class ClassMemberInfoAnnotations {
+    /** Annotation metadata access and query implementation. */
+    private final ClassMemberAnnotationInfo annotationInfoMetadata;
+
+    ClassMemberInfoAnnotations(final ClassMemberInfo classMemberInfo,
+            final @Nullable AnnotationInfoList annotationInfo) {
+        this.annotationInfoMetadata = new ClassMemberAnnotationInfo(classMemberInfo, annotationInfo);
+    }
+
+    AnnotationInfoList getAllAnnotationInfo() {
+        return annotationInfoMetadata.getAllAnnotationInfo();
+    }
+
+    AnnotationInfoList getDirectAnnotationInfo() {
+        return annotationInfoMetadata.getDirectAnnotationInfo();
+    }
+
+    @Nullable
+    AnnotationInfo getAllAnnotationInfo(final Class<? extends Annotation> annotation) {
+        return annotationInfoMetadata.getAllAnnotationInfo(annotation);
+    }
+
+    @Nullable
+    AnnotationInfo getAllAnnotationInfo(final String annotationName) {
+        return annotationInfoMetadata.getAllAnnotationInfo(annotationName);
+    }
+
+    @Nullable
+    AnnotationInfo getDirectAnnotationInfo(final Class<? extends Annotation> annotation) {
+        return annotationInfoMetadata.getDirectAnnotationInfo(annotation);
+    }
+
+    @Nullable
+    AnnotationInfo getDirectAnnotationInfo(final String annotationName) {
+        return annotationInfoMetadata.getDirectAnnotationInfo(annotationName);
+    }
+
+    AnnotationInfoList getAllAnnotationInfoRepeatable(final Class<? extends Annotation> annotation) {
+        return annotationInfoMetadata.getAllAnnotationInfoRepeatable(annotation);
+    }
+
+    AnnotationInfoList getAllAnnotationInfoRepeatable(final String annotationName) {
+        return annotationInfoMetadata.getAllAnnotationInfoRepeatable(annotationName);
+    }
+
+    AnnotationInfoList getDirectAnnotationInfoRepeatable(final Class<? extends Annotation> annotation) {
+        return annotationInfoMetadata.getDirectAnnotationInfoRepeatable(annotation);
+    }
+
+    AnnotationInfoList getDirectAnnotationInfoRepeatable(final String annotationName) {
+        return annotationInfoMetadata.getDirectAnnotationInfoRepeatable(annotationName);
+    }
+
+    boolean hasAnnotation(final Class<? extends Annotation> annotation) {
+        return annotationInfoMetadata.hasAnnotation(annotation);
+    }
+
+    boolean hasAnnotation(final String annotationName) {
+        return annotationInfoMetadata.hasAnnotation(annotationName);
+    }
+}
