+++ b/pac4j-core/src/main/java/org/pac4j/core/client/IndirectClientAuthenticationState.java
@@ -0,0 +1,60 @@
+package org.pac4j.core.client;
+
+import org.pac4j.core.context.WebContext;
+import org.pac4j.core.context.session.SessionStore;
+import org.pac4j.core.util.Pac4jConstants;
+
+/**
+ * Authentication-attempt state and session attribute naming for an indirect client.
+ */
+public class IndirectClientAuthenticationState {
+
+    public static final String ATTEMPTED_AUTHENTICATION_SUFFIX = "$attemptedAuthentication";
+    private static final String STATE_SESSION_PARAMETER = "$stateSessionParameter";
+    private static final String NONCE_SESSION_PARAMETER = "$nonceSessionParameter";
+    private static final String CODE_VERIFIER_SESSION_PARAMETER = "$codeVerifierSessionParameter";
+
+    private final IndirectClient client;
+    private boolean checkAuthenticationAttempt = true;
+
+    public IndirectClientAuthenticationState(final IndirectClient client) {
+        this.client = client;
+    }
+
+    public String getStateSessionAttributeName() {
+        return client.getName() + STATE_SESSION_PARAMETER;
+    }
+
+    public String getNonceSessionAttributeName() {
+        return client.getName() + NONCE_SESSION_PARAMETER;
+    }
+
+    public String getCodeVerifierSessionAttributeName() {
+        return client.getName() + CODE_VERIFIER_SESSION_PARAMETER;
+    }
+
+    public boolean isCheckAuthenticationAttempt() {
+        return checkAuthenticationAttempt;
+    }
+
+    public void setCheckAuthenticationAttempt(final boolean checkAuthenticationAttempt) {
+        this.checkAuthenticationAttempt = checkAuthenticationAttempt;
+    }
+
+    public boolean isAuthenticationAttempted(final WebContext context, final SessionStore sessionStore) {
+        final var attemptedAuth = sessionStore.get(context, client.getName() + ATTEMPTED_AUTHENTICATION_SUFFIX);
+        return attemptedAuth.isPresent() && !Pac4jConstants.EMPTY_STRING.equals(attemptedAuth.get());
+    }
+
+    public void saveAttemptedAuthentication(final WebContext context, final SessionStore sessionStore) {
+        if (checkAuthenticationAttempt) {
+            client.logger.debug("save authentication attempt in session");
+            sessionStore.set(context, client.getName() + ATTEMPTED_AUTHENTICATION_SUFFIX, "true");
+        }
+    }
+
+    public void cleanAttemptedAuthentication(final WebContext context, final SessionStore sessionStore) {
+        client.logger.debug("clean authentication attempt from session");
+        sessionStore.set(context, client.getName() + ATTEMPTED_AUTHENTICATION_SUFFIX, null);
+    }
+}
