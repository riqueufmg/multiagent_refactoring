+/*
+ * Helper class extracted from Statement for type-checking / casting / optional / consumer helpers
+ */
+package com.github.javaparser.ast.stmt;
+
+import static com.github.javaparser.utils.CodeGenerationUtils.f;
+
+import java.util.Optional;
+import java.util.function.Consumer;
+
+public final class StatementTypeCasting {
+
+    private StatementTypeCasting() {}
+
+    // AssertStmt helpers
+    public static boolean isAssertStmt(Statement stmt) {
+        return stmt instanceof AssertStmt;
+    }
+
+    public static AssertStmt asAssertStmt(Statement stmt) {
+        if (stmt instanceof AssertStmt) {
+            return (AssertStmt) stmt;
+        }
+        throw new IllegalStateException(f("%s is not AssertStmt, it is %s", stmt, stmt.getClass().getSimpleName()));
+    }
+
+    public static void ifAssertStmt(Statement stmt, Consumer<AssertStmt> action) {
+        if (stmt instanceof AssertStmt) {
+            action.accept((AssertStmt) stmt);
+        }
+    }
+
+    public static Optional<AssertStmt> toAssertStmt(Statement stmt) {
+        return stmt instanceof AssertStmt ? Optional.of((AssertStmt) stmt) : Optional.empty();
+    }
+
+    // BlockStmt helpers
+    public static boolean isBlockStmt(Statement stmt) {
+        return stmt instanceof BlockStmt;
+    }
+
+    public static BlockStmt asBlockStmt(Statement stmt) {
+        if (stmt instanceof BlockStmt) {
+            return (BlockStmt) stmt;
+        }
+        throw new IllegalStateException(f("%s is not BlockStmt, it is %s", stmt, stmt.getClass().getSimpleName()));
+    }
+
+    public static void ifBlockStmt(Statement stmt, Consumer<BlockStmt> action) {
+        if (stmt instanceof BlockStmt) {
+            action.accept((BlockStmt) stmt);
+        }
+    }
+
+    public static Optional<BlockStmt> toBlockStmt(Statement stmt) {
+        return stmt instanceof BlockStmt ? Optional.of((BlockStmt) stmt) : Optional.empty();
+    }
+
+    // BreakStmt helpers
+    public static boolean isBreakStmt(Statement stmt) {
+        return stmt instanceof BreakStmt;
+    }
+
+    public static BreakStmt asBreakStmt(Statement stmt) {
+        if (stmt instanceof BreakStmt) {
+            return (BreakStmt) stmt;
+        }
+        throw new IllegalStateException(f("%s is not BreakStmt, it is %s", stmt, stmt.getClass().getSimpleName()));
+    }
+
+    public static void ifBreakStmt(Statement stmt, Consumer<BreakStmt> action) {
+        if (stmt instanceof BreakStmt) {
+            action.accept((BreakStmt) stmt);
+        }
+    }
+
+    public static Optional<BreakStmt> toBreakStmt(Statement stmt) {
+        return stmt instanceof BreakStmt ? Optional.of((BreakStmt) stmt) : Optional.empty();
+    }
+
+    // ContinueStmt helpers
+    public static boolean isContinueStmt(Statement stmt) {
+        return stmt instanceof ContinueStmt;
+    }
+
+    public static ContinueStmt asContinueStmt(Statement stmt) {
+        if (stmt instanceof ContinueStmt) {
+            return (ContinueStmt) stmt;
+        }
+        throw new IllegalStateException(f("%s is not ContinueStmt, it is %s", stmt, stmt.getClass().getSimpleName()));
+    }
+
+    public static void ifContinueStmt(Statement stmt, Consumer<ContinueStmt> action) {
+        if (stmt instanceof ContinueStmt) {
+            action.accept((ContinueStmt) stmt);
+        }
+    }
+
+    public static Optional<ContinueStmt> toContinueStmt(Statement stmt) {
+        return stmt instanceof ContinueStmt ? Optional.of((ContinueStmt) stmt) : Optional.empty();
+    }
+}
