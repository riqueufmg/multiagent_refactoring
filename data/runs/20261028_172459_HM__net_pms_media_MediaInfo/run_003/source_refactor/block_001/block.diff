+package net.pms.media;
+
+import java.io.File;
+import java.util.Locale;
+import net.pms.PMS;
+import net.pms.configuration.UmsConfiguration;
+import net.pms.dlna.DLNAThumbnail;
+import net.pms.dlna.InputFile;
+import net.pms.formats.AudioAsVideo;
+import net.pms.formats.Format;
+import net.pms.image.ImageFormat;
+import net.pms.image.ImagesUtil.ScaleType;
+import net.pms.media.audio.MediaAudio;
+import net.pms.network.mediaserver.handlers.api.starrating.StarRating;
+import net.pms.util.CoverSupplier;
+import net.pms.util.CoverUtil;
+import net.pms.util.FileUtil;
+import org.apache.commons.lang3.StringUtils;
+import org.apache.commons.lang3.math.NumberUtils;
+import org.jaudiotagger.audio.AudioFile;
+import org.jaudiotagger.audio.AudioFileIO;
+import org.jaudiotagger.audio.AudioHeader;
+import org.jaudiotagger.tag.FieldKey;
+import org.jaudiotagger.tag.Tag;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Parses metadata and embedded artwork from audio files.
+ */
+public final class MediaAudioParser {
+	private static final Logger LOGGER = LoggerFactory.getLogger(MediaAudioParser.class);
+	private static final UmsConfiguration CONFIGURATION = PMS.getConfiguration();
+
+	private MediaAudioParser() {
+	}
+
+	/**
+	 * Parses audio metadata into the supplied media information instance.
+	 *
+	 * @param media the media information receiving the parsed values
+	 * @param inputFile the input file
+	 * @param format the detected format
+	 * @param type the detected media type
+	 * @return {@code true} if the file was handled as audio
+	 */
+	public static boolean parse(MediaInfo media, InputFile inputFile, Format format, int type) {
+		if (media == null || inputFile == null || (type != Format.AUDIO && !(format instanceof AudioAsVideo))) {
+			return false;
+		}
+
+		File file = inputFile.getFile();
+		if (file == null) {
+			return false;
+		}
+
+		MediaAudio audio = new MediaAudio();
+		try {
+			AudioFile audioFile;
+			if ("mp2".equalsIgnoreCase(FileUtil.getExtension(file))) {
+				audioFile = AudioFileIO.readAs(file, "mp3");
+			} else {
+				audioFile = AudioFileIO.read(file);
+			}
+
+			AudioHeader header = audioFile.getAudioHeader();
+			if (header != null) {
+				int length = header.getTrackLength();
+				int rate = header.getSampleRateAsNumber();
+				if (header.getEncodingType() != null && header.getEncodingType().toLowerCase(Locale.ROOT).contains("flac 24")) {
+					audio.setBitsperSample(24);
+				}
+				audio.setSampleFrequency(Integer.toString(rate));
+				media.setDuration((double) length);
+				media.setBitrate((int) header.getBitRateAsNumber());
+				audio.getAudioProperties().setNumberOfChannels(parseChannels(header.getChannels()));
+				if (StringUtils.isNotBlank(header.getEncodingType())) {
+					audio.setCodecA(header.getEncodingType());
+				}
+				if (audio.getCodecA() != null && audio.getCodecA().contains("(windows media")) {
+					audio.setCodecA(audio.getCodecA().substring(0, audio.getCodecA().indexOf("(windows media")).trim());
+				}
+			}
+
+			Tag tag = audioFile.getTag();
+			if (tag != null) {
+				setThumbnail(media, tag);
+				audio.setAlbum(value(tag, FieldKey.ALBUM));
+				audio.setArtist(value(tag, FieldKey.ARTIST));
+				audio.setComposer(value(tag, FieldKey.COMPOSER));
+				audio.setConductor(value(tag, FieldKey.CONDUCTOR));
+				audio.setSongname(value(tag, FieldKey.TITLE));
+				audio.setMbidRecord(value(tag, FieldKey.MUSICBRAINZ_RELEASEID));
+				audio.setMbidTrack(value(tag, FieldKey.MUSICBRAINZ_TRACK_ID));
+				audio.setRating(StarRating.convertTagRatingToStar(tag));
+				audio.setGenre(value(tag, FieldKey.GENRE));
+				String year = value(tag, FieldKey.YEAR);
+				if (year != null) {
+					year = year.length() > 4 ? year.substring(0, 4) : year;
+					if (NumberUtils.isParsable(year)) {
+						audio.setYear(Integer.parseInt(year));
+					}
+				}
+				audio.setTrack(integerValue(tag, FieldKey.TRACK, 1));
+			}
+		} catch (Exception e) {
+			LOGGER.debug("Error parsing audio file {}: {}", file, e.getMessage());
+			LOGGER.trace("Audio parsing failure", e);
+		}
+
+		if (StringUtils.isBlank(audio.getSongname())) {
+			audio.setSongname(file.getName());
+		}
+		if (StringUtils.isBlank(media.getContainer())) {
+			media.setContainer(audio.getCodecA());
+		}
+		media.getAudioTracksList().add(audio);
+		return true;
+	}
+
+	/**
+	 * Parses only audio artwork for thumbnail generation.
+	 *
+	 * @param media the media information receiving the thumbnail
+	 * @param inputFile the input file
+	 * @param format the detected format
+	 * @param type the detected media type
+	 */
+	public static void parseThumbnailOnly(MediaInfo media, InputFile inputFile, Format format, int type) {
+		if (media == null || inputFile == null || (type != Format.AUDIO && !(format instanceof AudioAsVideo))) {
+			return;
+		}
+		File file = inputFile.getFile();
+		if (file == null) {
+			return;
+		}
+		try {
+			AudioFile audioFile = "mp2".equalsIgnoreCase(FileUtil.getExtension(file))
+				? AudioFileIO.readAs(file, "mp3")
+				: AudioFileIO.read(file);
+			Tag tag = audioFile.getTag();
+			if (tag != null) {
+				setThumbnail(media, tag);
+			}
+		} catch (Exception e) {
+			LOGGER.debug("Error parsing audio thumbnail for {}: {}", file, e.getMessage());
+			LOGGER.trace("Audio thumbnail parsing failure", e);
+		}
+	}
+
+	private static void setThumbnail(MediaInfo media, Tag tag) throws Exception {
+		if (!tag.getArtworkList().isEmpty()) {
+			media.setThumb(DLNAThumbnail.toThumbnail(tag.getArtworkList().get(0).getBinaryData(), 640, 480, ScaleType.MAX, ImageFormat.SOURCE, false));
+		} else if (!CONFIGURATION.getAudioThumbnailMethod().equals(CoverSupplier.NONE)) {
+			media.setThumb(DLNAThumbnail.toThumbnail(CoverUtil.get().getThumbnail(tag), 640, 480, ScaleType.MAX, ImageFormat.SOURCE, false));
+		}
+	}
+
+	private static int parseChannels(String channels) {
+		if (StringUtils.isBlank(channels)) {
+			return 2;
+		}
+		String value = channels.toLowerCase(Locale.ROOT);
+		if (value.equals("1") || value.contains("mono")) {
+			return 1;
+		}
+		if (value.equals("2") || value.equals("0") || value.contains("stereo")) {
+			return 2;
+		}
+		try {
+			return Integer.parseInt(value);
+		} catch (NumberFormatException e) {
+			return 2;
+		}
+	}
+
+	private static String value(Tag tag, FieldKey key) {
+		try {
+			String value = tag.getFirst(key);
+			return StringUtils.isBlank(value) ? null : value;
+		} catch (Exception e) {
+			return null;
+		}
+	}
+
+	private static Integer integerValue(Tag tag, FieldKey key, int defaultValue) {
+		String value = value(tag, key);
+		if (value != null) {
+			try {
+				return Integer.valueOf(value);
+			} catch (NumberFormatException e) {
+				LOGGER.trace("Could not parse audio tag value {}", value);
+			}
+		}
+		return defaultValue;
+	}
+}
