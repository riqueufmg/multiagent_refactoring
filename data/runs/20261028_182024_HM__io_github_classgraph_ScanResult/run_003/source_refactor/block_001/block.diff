+package io.github.classgraph;
+
+/**
+ * Serialization compatibility facade for {@link ScanResult}.
+ *
+ * <p>This package-private class centralizes access to the JSON serialization
+ * operations without changing the public {@link ScanResult} API.</p>
+ */
+final class ScanResultSerialization {
+    /** Do not instantiate. */
+    private ScanResultSerialization() {
+    }
+
+    /**
+     * Deserialize a scan result from JSON.
+     *
+     * @param json the serialized scan result
+     * @return the deserialized scan result
+     */
+    static ScanResult fromJSON(final String json) {
+        return ScanResult.fromJSON(json);
+    }
+
+    /**
+     * Serialize a scan result to JSON.
+     *
+     * @param scanResult the scan result
+     * @param indentWidth the indentation width
+     * @return the serialized scan result
+     */
+    static String toJSON(final ScanResult scanResult, final int indentWidth) {
+        return scanResult.toJSON(indentWidth);
+    }
+
+    /**
+     * Serialize a scan result to minified JSON.
+     *
+     * @param scanResult the scan result
+     * @return the serialized scan result
+     */
+    static String toJSON(final ScanResult scanResult) {
+        return scanResult.toJSON();
+    }
+}
