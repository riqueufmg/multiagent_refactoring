@@ -0,0 +1,63 @@
+package org.pac4j.cas.config;
+
+import org.apereo.cas.client.validation.Cas20ServiceTicketValidator;
+import org.apereo.cas.client.validation.TicketValidator;
+import org.pac4j.core.context.WebContext;
+
+/**
+ * Configuration for CAS ticket validation.
+ */
+public class CasTicketValidatorConfiguration {
+
+    private final CasConfiguration casConfiguration;
+
+    private final CasSecurityConfiguration securityConfiguration;
+
+    private TicketValidator defaultTicketValidator;
+
+    public CasTicketValidatorConfiguration(final CasConfiguration casConfiguration,
+                                           final CasSecurityConfiguration securityConfiguration) {
+        this.casConfiguration = casConfiguration;
+        this.securityConfiguration = securityConfiguration;
+    }
+
+    public TicketValidator retrieveTicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).retrieveTicketValidator(context);
+    }
+
+    protected TicketValidator buildSAMLTicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildSAMLTicketValidator(context);
+    }
+
+    protected void addPrivateKey(final Cas20ServiceTicketValidator validator) {
+        securityConfiguration.addPrivateKey(validator);
+    }
+
+    protected TicketValidator buildCas30ProxyTicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildCas30ProxyTicketValidator(context);
+    }
+
+    protected TicketValidator buildCas30TicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildCas30TicketValidator(context);
+    }
+
+    protected TicketValidator buildCas20ProxyTicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildCas20ProxyTicketValidator(context);
+    }
+
+    protected TicketValidator buildCas20TicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildCas20TicketValidator(context);
+    }
+
+    protected TicketValidator buildCas10TicketValidator(final WebContext context) {
+        return new CasTicketValidatorFactory(casConfiguration).buildCas10TicketValidator(context);
+    }
+
+    public TicketValidator getDefaultTicketValidator() {
+        return defaultTicketValidator;
+    }
+
+    public void setDefaultTicketValidator(final TicketValidator defaultTicketValidator) {
+        this.defaultTicketValidator = defaultTicketValidator;
+    }
+}
